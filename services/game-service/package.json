{
  "name": "game-service",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "build:gdk": "npm run build --prefix ../../packages/game-gdk",
    "build": "npm run build:gdk && tsc",
    "db:migrate": "prisma migrate deploy --schema prisma/schema",
    "db:push": "prisma db push --schema prisma/schema",
    "db:seed": "prisma db seed --schema prisma/schema",
    "prisma:generate": "prisma generate --schema prisma/schema",
    "seed:persistent": "ts-node src/scripts/seedPersistentData.ts",
    "start": "node dist/index.js",
    "start:debug": "node --inspect=0.0.0.0:9229 -r ts-node/register src/index.ts"
  },
  "prisma": {
    "schema": "prisma/schema",
    "seed": "ts-node prisma/seed/index.ts"
  },
  "dependencies": {
    "@trying-sd/game-gdk": "file:../../packages/game-gdk",
    "@aws-sdk/client-dynamodb": "^3.1054.0",
    "@aws-sdk/lib-dynamodb": "^3.1054.0",
    "@prisma/client": "^5.22.0",
    "body-parser": "^1.20.2",
    "chess.js": "^1.4.0",
    "express": "^4.18.2",
    "kafkajs": "^2.2.4",
    "node-fetch": "^2.6.7",
    "redis": "^4.7.0",
    "ws": "^8.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/node-fetch": "^2.6.11",
    "@types/ws": "^8.5.10",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
