generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GameSpin {
  id          BigInt    @id @default(autoincrement())
  userId      String    @map("user_id")
  roomId      String    @map("room_id")
  roundId     String    @map("round_id")
  gameId      String    @map("game_id")
  requestId   String    @map("request_id")
  spinId      String    @map("spin_id")
  betAmount   Int       @map("bet_amount")
  status      String    @default("PENDING")
  winAmount   Int?      @map("win_amount")
  symbols     Json?
  balance     Int?
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  failedAt    DateTime? @map("failed_at")
  round       GameRound @relation(fields: [roundId], references: [roundId])

  @@unique([roundId, spinId])
  @@map("game_spins")
}

model GameRound {
  id          BigInt     @id @default(autoincrement())
  roundId     String     @unique @map("round_id")
  userId      String     @map("user_id")
  roomId      String     @map("room_id")
  status      String
  createdAt   DateTime   @default(now()) @map("created_at")
  completedAt DateTime?  @map("completed_at")
  spins       GameSpin[]
  actions     RoundAction[]

  @@map("game_rounds")
}

model RoundAction {
  id        BigInt    @id @default(autoincrement())
  roundId   String    @map("round_id")
  userId    String    @map("user_id")
  roomId    String    @map("room_id")
  action    String
  requestId String    @map("request_id")
  payload   Json
  result    Json?
  createdAt DateTime  @default(now()) @map("created_at")
  round     GameRound @relation(fields: [roundId], references: [roundId])

  @@unique([roundId, action, requestId])
  @@index([roundId, createdAt])
  @@map("round_actions")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventKey    String    @unique @map("event_key")
  eventType   String    @map("event_type")
  payload     Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

model ChessGame {
  chessGameId String      @id @map("chess_game_id")
  roomId      String      @unique @map("room_id")
  currentFen  String      @map("current_fen")
  status      String
  turn        String
  moveNumber  Int         @default(0) @map("move_number")
  whiteUserId String?     @map("white_user_id")
  blackUserId String?     @map("black_user_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @default(now()) @map("updated_at")
  moves       ChessMove[]

  @@map("chess_games")
}

model ChessMove {
  id          BigInt    @id @default(autoincrement())
  chessGameId String    @map("chess_game_id")
  moveNumber  Int       @map("move_number")
  userId      String    @map("user_id")
  color       String
  fromSquare  String    @map("from_square")
  toSquare    String    @map("to_square")
  promotion   String?
  san         String
  lan         String
  fenAfter    String    @map("fen_after")
  createdAt   DateTime  @default(now()) @map("created_at")
  game        ChessGame @relation(fields: [chessGameId], references: [chessGameId])

  @@unique([chessGameId, moveNumber])
  @@map("chess_moves")
}
