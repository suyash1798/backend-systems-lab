model ChessGame {
  chessGameId String      @id @map("chess_game_id")
  roomId      String      @unique @map("room_id")
  currentFen  String      @map("current_fen")
  status      String
  turn        String
  moveNumber  Int         @default(0) @map("move_number")
  whiteUserId String?     @map("white_user_id")
  blackUserId String?     @map("black_user_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @default(now()) @map("updated_at")
  moves       ChessMove[]

  @@map("chess_games")
}

model ChessMove {
  id          BigInt    @id @default(autoincrement())
  chessGameId String    @map("chess_game_id")
  moveNumber  Int       @map("move_number")
  userId      String    @map("user_id")
  color       String
  fromSquare  String    @map("from_square")
  toSquare    String    @map("to_square")
  promotion   String?
  san         String
  lan         String
  fenAfter    String    @map("fen_after")
  createdAt   DateTime  @default(now()) @map("created_at")
  game        ChessGame @relation(fields: [chessGameId], references: [chessGameId])

  @@unique([chessGameId, moveNumber])
  @@map("chess_moves")
}
